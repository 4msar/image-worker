{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "unsplash-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"observability": {
		"enabled": true
	}
	// Optional secrets, one per API provider: UNSPLASH_ACCESS_KEY, PEXELS_API_KEY, PIXABAY_API_KEY.
	// Set them with `npx wrangler secret put <NAME>`; a provider without its key is hidden.
	// For local dev, copy .dev.vars.example to .dev.vars and fill in the keys.
}
